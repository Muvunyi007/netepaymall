[Unit]
Description=NETEPAMALL Web (Next.js)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/netepamall/web
Environment=NODE_ENV=production
Environment=PORT=8001
ExecStart=/usr/bin/npm run start -- -p 8001
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
